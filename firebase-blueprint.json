{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Real estate lead and plantao attendance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string", "maxLength": 150 },
        "clientPhone": { "type": "string", "maxLength": 50 },
        "clientEmail": { "type": "string", "maxLength": 150 },
        "brokerName": { "type": "string", "maxLength": 100 },
        "development": { "type": "string", "maxLength": 150 },
        "origin": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["lead", "visita_plantao", "montagem_pasta", "credito_condicionado", "credito_reprovado", "credito_aprovado", "venda_realizada"] },
        "propertyUnit": { "type": "string", "maxLength": 50 },
        "propertyValue": { "type": "number" },
        "commissionRate": { "type": "number" },
        "visitDate": { "type": "string" },
        "notes": { "type": "string", "maxLength": 2000 },
        "pastaStatus": { "type": "string" },
        "creditStatus": { "type": "string" },
        "nextAction": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "clientName", "clientPhone", "brokerName", "development", "status"]
    },
    "Broker": {
      "title": "Broker",
      "description": "Real estate broker profile and goal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "team": { "type": "string", "maxLength": 100 },
        "creci": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "monthlyGoal": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Development": {
      "title": "Development",
      "description": "Real estate development / property project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "maxLength": 100 },
        "developer": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 250 },
        "unitsTotal": { "type": "number" },
        "unitsAvailable": { "type": "number" },
        "priceRange": { "type": "string", "maxLength": 100 },
        "estimatedVGV": { "type": "number" },
        "status": { "type": "string", "enum": ["lancamento", "obras", "pronto"] }
      },
      "required": ["id", "name"]
    },
    "Origin": {
      "title": "Origin",
      "description": "Lead marketing origin / channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string" },
        "description": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Team": {
      "title": "Team",
      "description": "Broker team / squad",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "leader": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "CRM task item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "dueDate": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "assignedTo": { "type": "string", "maxLength": 100 },
        "relatedClient": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Leads collection"
    },
    "/brokers/{brokerId}": {
      "schema": { "$ref": "#/entities/Broker" },
      "description": "Brokers collection"
    },
    "/developments/{devId}": {
      "schema": { "$ref": "#/entities/Development" },
      "description": "Developments collection"
    },
    "/origins/{originId}": {
      "schema": { "$ref": "#/entities/Origin" },
      "description": "Origins collection"
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "#/entities/Team" },
      "description": "Teams collection"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks collection"
    }
  }
}
