rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLead(data) {
      return data.keys().hasAll(['id', 'clientName', 'clientPhone', 'brokerName', 'development', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.clientName is string && data.clientName.size() <= 150 &&
             data.clientPhone is string && data.clientPhone.size() <= 50 &&
             data.brokerName is string && data.brokerName.size() <= 100 &&
             data.development is string && data.development.size() <= 150 &&
             data.status is string;
    }

    function isValidBroker(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 150;
    }

    function isValidDevelopment(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 150;
    }

    function isValidOrigin(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /leads/{leadId} {
      allow read, list: if true;
      allow create, update: if isValidId(leadId) && isValidLead(request.resource.data);
      allow delete: if isValidId(leadId);
    }

    match /brokers/{brokerId} {
      allow read, list: if true;
      allow create, update: if isValidId(brokerId) && isValidBroker(request.resource.data);
      allow delete: if isValidId(brokerId);
    }

    match /developments/{devId} {
      allow read, list: if true;
      allow create, update: if isValidId(devId) && isValidDevelopment(request.resource.data);
      allow delete: if isValidId(devId);
    }

    match /origins/{originId} {
      allow read, list: if true;
      allow create, update: if isValidId(originId) && isValidOrigin(request.resource.data);
      allow delete: if isValidId(originId);
    }

    match /teams/{teamId} {
      allow read, list: if true;
      allow create, update: if isValidId(teamId) && isValidTeam(request.resource.data);
      allow delete: if isValidId(teamId);
    }

    match /tasks/{taskId} {
      allow read, list: if true;
      allow create, update: if isValidId(taskId) && isValidTask(request.resource.data);
      allow delete: if isValidId(taskId);
    }

    match /users/{userId} {
      allow read, list: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    match /distribution_rules/{ruleId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(ruleId);
    }

    match /distribution_settings/{settingId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    match /distribution_logs/{logId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(logId);
    }
  }
}
